# Copie para ".env" (que esta no .gitignore) e preencha os CHANGE_ME.
#
# ATENCAO: os mesmos usuario e senha precisam aparecer identicos em TRES
# arquivos -- este, infra/k8s/postgres/secret.yaml e
# infra/helm/airflow-secrets.yaml. Nada valida isso, e divergir causa falha
# longe da causa: senha diferente no TARGET_* quebra a carga do Meltano, e
# diferente na URI quebra a task validate_row_counts no fim do pipeline.
#
# Deste arquivo, o projeto le apenas POSTGRES_USER (no alvo
# create-airflow-metadata-db do Makefile). As demais variaveis estao aqui para
# voce preencher uma vez e replicar nos Secrets acima -- dentro do cluster,
# quem entrega esses valores aos pods sao os Secrets, nao este arquivo.

# --- Postgres ---
# POSTGRES_* e TARGET_POSTGRES_* sao o MESMO banco, com duas convencoes de
# nome: as primeiras inicializam o container postgres:16-alpine, as segundas
# sao o que o Meltano resolve via ${TARGET_POSTGRES_*} no meltano.yml.
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=banvic_dw

TARGET_POSTGRES_HOST=postgres.banvic.svc.cluster.local
TARGET_POSTGRES_PORT=5432
TARGET_POSTGRES_USER=CHANGE_ME
TARGET_POSTGRES_PASSWORD=CHANGE_ME
TARGET_POSTGRES_DB=banvic_dw

# --- Airflow ---
# Gere com: python3 -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME

# Terceira copia do usuario/senha, agora dentro de uma URI. Se a senha tiver
# caractere especial (@ : / ? # etc.), ela precisa ir URL-encoded AQUI --
# nos campos acima vai literal.
AIRFLOW_CONN_BANVIC_DEST=postgresql://CHANGE_ME:CHANGE_ME@postgres.banvic.svc.cluster.local:5432/banvic_dw
